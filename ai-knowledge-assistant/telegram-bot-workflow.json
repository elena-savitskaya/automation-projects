    {
      "id": "aa69c37d-6f11-41c5-b495-1a9ac71dc878",
      "name": "Prepare lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        -200
      ],
      "parameters": {
        "jsCode": "const msg = $('Telegram Trigger').first().json.message;\nconst sd = $getWorkflowStaticData('global');\nsd.requests = sd.requests || {};\nconst chatId = String(msg.chat.id);\nlet phone = msg.contact ? msg.contact.phone_number : ($json.phone || '');\nphone = String(phone).replace(/[^+\\d]/g, '');\nif (phone && !phone.startsWith('+')) phone = '+' + phone;\nconst name = [msg.from.first_name, msg.from.last_name].filter(Boolean).join(' ');\nconst request = sd.requests[chatId] || 'Запис (послугу уточнити)';\ndelete sd.requests[chatId];\nreturn [{ json: {\n  'Дата': $now.setZone('Europe/Kyiv').toFormat('yyyy-MM-dd HH:mm'),\n  \"Ім'я\": name,\n  'Username': msg.from.username ? '@' + msg.from.username : '',\n  'Телефон': phone,\n  'Запит': request,\n  'Chat ID': chatId,\n  'Статус': 'Новий'\n} }];"
      }
