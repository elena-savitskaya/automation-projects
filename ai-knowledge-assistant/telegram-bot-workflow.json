    {
      "parameters": {
        "chatId": "={{ $json.message.chat.id }}",
        "text": "Вітаємо у FORMA Barbershop! 👋\n\nЯ онлайн-адміністратор. Підкажу ціни, майстрів, графік роботи, правила запису чи допоможу обрати послугу.\n\nНапишіть своє питання 💈",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "id": "4837d772-0473-4db9-a652-c9cab8e3c269",
