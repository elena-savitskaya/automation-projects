    {
      "id": "938f4dc5-89d3-48f5-bd3f-edf5c6fff950",
      "name": "Parse reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        100
      ],
      "parameters": {
        "jsCode": "const out = $json.output || '';\nconst chatId = String($('Telegram Trigger').first().json.message.chat.id);\nconst sd = $getWorkflowStaticData('global');\nsd.requests = sd.requests || {};\nlet text = out, route = 'answer', phone = null;\nconst ask = text.match(/\\[ASK_PHONE(?::\\s*([^\\]]*))?\\]/);\nif (ask) { route = 'ask'; if (ask[1]) sd.requests[chatId] = ask[1].trim(); text = text.replace(ask[0], '').trim(); }\nconst ph = text.match(/\\[PHONE:\\s*([^\\]]+)\\]/);\nif (ph) { route = 'lead'; phone = ph[1].trim(); text = text.replace(ph[0], '').trim(); }\ntext = text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\nreturn [{ json: { text, route, phone, chatId } }];"
      }
    },
